// Prisma schema for CakeFlow — one bakery per deployment (tenant), SQLite.
// Every tenant-owned row carries `bakeryId`; repositories must never query without it.
//
// SQLite (via Prisma) supports neither `enum` nor `Json`, so:
//   * status/role/kind columns are plain TEXT. The allowed values live in
//     `@cakeflow/contracts` and are enforced by the zod schemas at the API edge
//     (and by the typed constants used across the service layer).
//   * JSON columns are TEXT holding serialised JSON; read/write them through
//     `src/common/json.ts` so the encoding stays consistent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Tenant root
// ─────────────────────────────────────────────────────────────

model Bakery {
  id           String  @id @default(cuid())
  slug         String  @unique
  customDomain String? @unique
  name         String
  legalName    String?
  email        String
  phone        String?
  timezone     String  @default("Australia/Melbourne")
  currency     String  @default("AUD")

  // Storefront / branding
  logoUrl      String?
  heroImageUrl String?
  brandColor   String  @default("#C084A0")
  about        String?
  addressLine  String?
  suburb       String?
  postcode     String?

  // Stripe Connect (destination charges)
  stripeAccountId     String? @unique
  stripeChargesEnabled Boolean @default(false)

  // Deposit policy
  depositType       String @default("FLAT") // "FLAT" | "PERCENTAGE"
  depositValue      Int    @default(2000) // FLAT = cents, PERCENTAGE = basis points (2500 = 25%)
  depositRefundable Boolean @default(true)
  refundWindowHours Int     @default(48)
  holdMinutes       Int     @default(15)
  leadTimeHours     Int     @default(48)
  maxAdvanceDays    Int     @default(90)

  // Privacy / storage limitation (GDPR Art. 5(1)(e))
  // Days after which closed orders are anonymised by the retention job.
  piiRetentionDays  Int     @default(730)

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users     User[]
  cakes     Cake[]
  slots     Slot[]
  orders    Order[]
  payments  Payment[]
  outbox    EmailOutbox[]
  events    OrderEvent[]
  privacyRequests PrivacyRequest[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  bakeryId     String
  email        String
  name         String
  phone        String?
  passwordHash String? // null for guest/customer accounts
  role         String    @default("CUSTOMER") // "OWNER" | "STAFF" | "CUSTOMER"
  isActive     Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bakery   Bakery    @relation(fields: [bakeryId], references: [id], onDelete: Cascade)
  sessions Session[]
  orders   Order[]   @relation("CustomerOrders")
  createdOrders Order[] @relation("CreatedByStaff")

  @@unique([bakeryId, email])
  @@index([bakeryId, role, isActive])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique // sha256 hex
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Catalog — cakes are single SKUs (no modifier engine)
// ─────────────────────────────────────────────────────────────

model Cake {
  id           String  @id @default(cuid())
  bakeryId     String
  slug         String
  name         String // e.g. "Vanilla Bean Celebration"
  description  String?
  flavour      String
  sizeLabel    String // e.g. "30cm"
  servings     Int     @default(1)
  priceCents   Int
  imageUrl     String?
  allergens    String? // JSON: string[]
  leadTimeHours Int?   // overrides bakery default when set
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bakery Bakery  @relation(fields: [bakeryId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([bakeryId, slug])
  @@index([bakeryId, isActive, sortOrder])
}

// ─────────────────────────────────────────────────────────────
// Capacity — one row per pickup window
// ─────────────────────────────────────────────────────────────

model Slot {
  id          String     @id @default(cuid())
  bakeryId    String
  startsAt    DateTime
  endsAt      DateTime
  serviceDate DateTime   // bakery-local date, used for grouping/constraints
  capacity    Int        @default(1)
  bookedCount Int        @default(0)
  status      String     @default("OPEN") // "OPEN" | "CLOSED"
  priceOverrideCents Int? // optional time-based pricing
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  bakery Bakery  @relation(fields: [bakeryId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([bakeryId, startsAt])
  @@index([bakeryId, serviceDate, status])
}

// ─────────────────────────────────────────────────────────────
// Orders (appointments) + payment ledger
// ─────────────────────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  reference   String @unique // human-readable, e.g. CF-8K2M4Q
  bakeryId    String
  customerId  String
  cakeId      String
  slotId      String
  createdById String?

  status          String @default("HELD")
  fulfillmentType String @default("PICKUP")

  // Immutable customer snapshot (orders must survive profile edits)
  customerName  String
  customerEmail String
  customerPhone String
  notes         String?

  totalCents      Int
  depositCents    Int
  balanceDueCents Int
  currency        String

  depositRefundable   Boolean
  depositRefundedAt   DateTime?
  refundWindowHours   Int

  holdExpiresAt DateTime
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  cancellationReason String?
  idempotencyKey String

  // Consent + privacy lifecycle (GDPR Art. 7, 9, 13, 17)
  privacyPolicyVersion String?
  privacyAcceptedAt    DateTime?
  healthDataConsentAt  DateTime?
  anonymisedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bakery    Bakery     @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  customer  User       @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?      @relation("CreatedByStaff", fields: [createdById], references: [id], onDelete: SetNull)
  cake      Cake       @relation(fields: [cakeId], references: [id], onDelete: Restrict)
  slot      Slot       @relation(fields: [slotId], references: [id], onDelete: Restrict)
  payments  Payment[]
  events    OrderEvent[]
  outbox    EmailOutbox[]
  privacyRequests PrivacyRequest[]

  @@unique([bakeryId, idempotencyKey])
  @@index([bakeryId, status, createdAt])
  @@index([bakeryId, slotId, status])
  @@index([bakeryId, customerEmail])
  @@index([holdExpiresAt, status])
  @@index([anonymisedAt, createdAt])
}

model Payment {
  id        String @id @default(cuid())
  bakeryId  String
  orderId   String
  kind      String // "DEPOSIT" | "BALANCE" | "REFUND"
  status    String @default("REQUIRES_PAYMENT")
  amountCents Int
  currency  String

  stripePaymentIntentId String? @unique
  stripeChargeId        String?
  stripeRefundId        String?
  stripeEventId         String?

  refundable     Boolean  @default(true)
  refundedCents  Int      @default(0)
  failureCode    String?
  failureMessage String?
  refundedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bakery Bakery @relation(fields: [bakeryId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([bakeryId, status])
  @@index([orderId])
}

// Webhook idempotency. Global table: Stripe events are not tenant-scoped.
model StripeEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  payload       String   // JSON: raw Stripe event
  processingAt  DateTime?
  processedAt   DateTime?
  error         String?
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([processedAt, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Audit + reliable email (transactional outbox)
// ─────────────────────────────────────────────────────────────

model OrderEvent {
  id       String         @id @default(cuid())
  bakeryId String
  orderId  String
  type     String         // OrderEventType
  actorType String        @default("SYSTEM") // "CUSTOMER" | "BAKER" | "SYSTEM" | "STRIPE"
  actorId  String?
  metadata String?        // JSON
  createdAt DateTime      @default(now())

  bakery Bakery @relation(fields: [bakeryId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([bakeryId, type, createdAt])
}

model EmailOutbox {
  id           String       @id @default(cuid())
  bakeryId     String
  orderId      String?
  toEmail      String
  template     String       // BOOKING_CONFIRMED | BOOKING_CANCELLED | ...
  payload      String       // JSON
  status       String       @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  attempts     Int          @default(0)
  nextAttemptAt DateTime    @default(now())
  sentAt       DateTime?
  lastError    String?
  createdAt    DateTime     @default(now())

  bakery Bakery @relation(fields: [bakeryId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([bakeryId, createdAt])
}

/// Accountability record for GDPR data-subject requests. The customer's email
/// is stored only as a SHA-256 hash so the audit log itself is not PII.
model PrivacyRequest {
  id          String               @id @default(cuid())
  bakeryId    String
  type        String               // "EXPORT" | "ERASURE"
  status      String               @default("COMPLETED")
  reference   String
  orderId     String?
  subjectEmailHash String
  reason      String?
  requestedAt DateTime             @default(now())
  completedAt DateTime?

  bakery Bakery @relation(fields: [bakeryId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([bakeryId, requestedAt])
  @@index([bakeryId, type, requestedAt])
}
