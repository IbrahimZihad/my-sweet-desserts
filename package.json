{
  "name": "cakeflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter @cakeflow/contracts build && pnpm -r --filter @cakeflow/api --filter @cakeflow/web build",
    "dev": "pnpm --filter @cakeflow/contracts build && dotenv -e .env -- pnpm -r --parallel --filter @cakeflow/api --filter @cakeflow/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @cakeflow/api prisma:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @cakeflow/api prisma:migrate",
    "db:deploy": "dotenv -e .env -- pnpm --filter @cakeflow/api prisma:deploy",
    "db:status": "dotenv -e .env -- pnpm --filter @cakeflow/api prisma:status",
    "db:seed": "dotenv -e .env -- pnpm --filter @cakeflow/api prisma:seed",
    "db:reset": "dotenv -e .env -- pnpm --filter @cakeflow/api prisma:reset",
    "db:studio": "dotenv -e .env -- pnpm --filter @cakeflow/api prisma:studio"
  },
  "devDependencies": {
    "dotenv-cli": "^11.1.0"
  }
}
