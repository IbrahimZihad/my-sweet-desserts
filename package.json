{
  "name": "cakeflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter @cakeflow/contracts build && pnpm -r --filter @cakeflow/api --filter @cakeflow/web build",
    "dev": "pnpm --filter @cakeflow/contracts build && pnpm -r --parallel --filter @cakeflow/api --filter @cakeflow/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @cakeflow/api prisma:generate",
    "db:migrate": "pnpm --filter @cakeflow/api prisma:migrate",
    "db:deploy": "pnpm --filter @cakeflow/api prisma:deploy",
    "db:seed": "pnpm --filter @cakeflow/api prisma:seed",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  }
}
