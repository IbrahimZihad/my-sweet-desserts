# ─────────────────────────────────────────────────────────────
# CakeFlow — root env template (copy to .env for docker compose)
# ─────────────────────────────────────────────────────────────

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=cakeflow
MYSQL_USER=cakeflow
MYSQL_PASSWORD=change-me

# API
NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://cakeflow:change-me@mysql:3306/cakeflow
JWT_ACCESS_SECRET=replace-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
WEB_ORIGIN=http://localhost:3000
INTERNAL_API_KEY=replace-with-a-long-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM="CakeFlow <bookings@example.com>"

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
