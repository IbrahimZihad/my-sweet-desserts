# ─────────────────────────────────────────────────────────────
# CakeFlow — root env template (copy to .env)
# ─────────────────────────────────────────────────────────────

# API
NODE_ENV=development
PORT=4000
# Create the database first: CREATE DATABASE cakeflow;
DATABASE_URL=mysql://cakeflow:change-me@localhost:3306/cakeflow
# Scratch database used by `prisma migrate dev` (create it once, keep it empty).
SHADOW_DATABASE_URL=mysql://cakeflow:change-me@localhost:3306/cakeflow_shadow
JWT_ACCESS_SECRET=replace-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
WEB_ORIGIN=http://localhost:3000
INTERNAL_API_KEY=replace-with-a-long-random-string

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM="CakeFlow <bookings@example.com>"

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_BAKERY_SLUG=sweetcrumbs

# Seed (development only)
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_STAFF_PASSWORD=StaffPass123!
# Set to 0 to skip the demo confirmed booking.
SEED_DEMO_BOOKING=1
